# Gustline Environment Configuration Example
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
STATIC_DIR=backend/static
WIND_DB_PATH=backend/data/wind.db

# Elexon API Endpoints (BMRS)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_ACTUALS_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/FUELHH
ELEXON_FORECASTS_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/WINDFOR
ELEXON_ACTUALS_STREAM_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/FUELHH/stream
ELEXON_FORECASTS_STREAM_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/WINDFOR/stream

# Frontend Environment Variables (Vite & React)
VITE_API_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000
